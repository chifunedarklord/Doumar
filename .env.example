# TaskFlow desktop — copy to .env; never commit .env.
DB_TYPE=sqlite
# Optional desktop storage override:
# DATABASE_URL=sqlite:////absolute/path/taskflow.db

# Account API (HTTPS for public deployments):
# TASKFLOW_API_URL=https://api.example.com
# Loopback development only:
# TASKFLOW_API_URL=http://127.0.0.1:8787
# TASKFLOW_ALLOW_LOCAL_API=1

# AI and merchant secrets belong in server/.env, not in the distributed desktop.
# See docs/SETUP.md and server/.env.example.
