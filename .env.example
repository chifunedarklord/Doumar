# TaskFlow - Environment Variables
# Copy file này thành .env và điền giá trị thực

# ── Gemini AI ────────────────────────────────────────────────
# Lấy API key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── SQL Server (bắt buộc) ─────────────────────────────────────
# Cài pyodbc trước: pip install pyodbc
# DB_SERVER=localhost          # hoặc: .\SQLEXPRESS | server\instance | IP
# DB_NAME=taskflow
# DB_USERNAME=                 # để trống = Windows Authentication
# DB_PASSWORD=                 # để trống = Windows Authentication
# DB_DRIVER=ODBC Driver 17 for SQL Server
