# Chỉ dùng trên máy chủ. Sao chép thành server/.env; không đóng gói vào desktop.
TASKFLOW_SERVER_DB=server-data/taskflow.sqlite
# XAMPP chỉ trên máy phát triển. Tạo database taskflow trước bằng phpMyAdmin.
# TASKFLOW_SERVER_DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/taskflow?charset=utf8mb4
# Khi đưa lên máy chủ, dùng user riêng có mật khẩu, không dùng root.
# TASKFLOW_PUBLIC_URL=https://api.example.com
# Chỉ đặt IP reverse proxy của bạn; proxy phải ghi đè X-Real-IP.
# TASKFLOW_TRUSTED_PROXIES=127.0.0.1,::1

# AI do nhà phát hành chi trả; không đặt khóa này trong bản desktop thương mại.
GEMINI_API_KEY=
TASKFLOW_AI_MODEL=gemini-3.1-flash-lite

# Khôi phục mật khẩu qua SMTP STARTTLS. Để trống khi chưa có dịch vụ email.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Thanh toán: cấu hình merchant và webhook trước khi mở bán.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Google Calendar — tạo OAuth Web Application, bật Calendar API.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/v1/google/callback
# Fernet key: chỉ đặt trên server; không đổi nếu chưa mã hóa lại credentials.
TASKFLOW_TOKEN_ENCRYPTION_KEY=

# Đăng nhập Google (độc lập với quyền Calendar; có thể dùng chung client ID).
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GOOGLE_LOGIN_REDIRECT_URI=http://127.0.0.1:8787/v1/auth/social/google/callback

# Đăng nhập Facebook — tạo Meta App và cấu hình Facebook Login.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Chọn phiên bản Graph API đang hỗ trợ trong Meta App Dashboard, dạng vNN.0.
FACEBOOK_GRAPH_VERSION=
FACEBOOK_LOGIN_REDIRECT_URI=
